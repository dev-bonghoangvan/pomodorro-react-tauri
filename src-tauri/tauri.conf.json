{
  "productName": "Pomodoro Tauri Pixi",
  "version": "0.1.0",
  "identifier": "com.example.pomodoro_tauri_pixi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pomodoro",
        "width": 400,
        "height": 700,
        "minWidth": 260,
        "minHeight": 80,
        "maxWidth":1366,
        "maxHeight":768,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; media-src 'self' data: https:; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://*.youtube.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }

  },
  "plugins": {}
}
